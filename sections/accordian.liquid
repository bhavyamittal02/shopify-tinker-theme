{{ 'accordian.css' | asset_url | stylesheet_tag }}

<div class="accordian-container">
    {% for block in section.blocks %}
        <div class="accordian-block">
            <div class="ques">
                <h3>{{ block.settings.question }}</h3>
                <span class="icon1">+</span>
            </div>
            <div class="ans active">
                <p>{{ block.settings.answer }}</p>
            </div>
        </div>
{% endfor %}
</div>

<script src="{{ 'accordian.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Accordian",
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordian",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "text",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordian"
    }
  ]
}
{% endschema %}
